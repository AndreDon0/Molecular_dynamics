# Looking at contration of copper

units metal
dimension 3
boundary p p p

read_data ./cu_to_gas.dat

neighbor 6 bin

pair_style eam/alloy
pair_coeff * * ./Cu_EAMX.eamalloy Cu

variable eatom equal pe/atoms

run 0
print "E/N = ${eatom}"

fix npt all npt temp 15000 100 0.1 iso 100000 100000 1
thermo 100
run 50000
print "E/N = ${eatom}"

write_data cu_to_gas_to_metal.dat