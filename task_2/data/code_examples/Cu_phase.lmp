# Looking at melting point of copper
# Melting point 1700 K because it is overheated.

units metal
dimension 3
boundary p p p

neighbor 6 bin

atom_style atomic
lattice fcc 3.62

region box block 0 5 0 5 0 5
create_box 1 box

create_atoms 1 box
mass 1 63.546
pair_style eam/alloy
pair_coeff * * ./Cu_EAMX.eamalloy Cu

fix npt all npt temp 300 3000 0.1 iso 1 1 1
velocity all create 300 54643
thermo 100
dump trj all custom 1000 coord_cooling.*.lammpstrj id type x y z
run 200000
print "E/N = ${eatom}"

write_data Cu_melt.dat