units           metal
dimension       3
boundary        p p p
atom_style      atomic

variable        a equal 3.615

lattice         fcc ${a}
region          box block 0 6 0 6 0 6 units lattice
create_box      1 box
create_atoms    1 box

mass            1 63.546

pair_style      eam/alloy
pair_coeff      * * ./Cu_EAMX.eamalloy Cu

variable        eatom equal pe/atoms
thermo          100

run             0

velocity all create 300 23243
fix nvt all nvt temp 300 300 0.1
run 10000

unfix nvt

variable t equal step*dt

compute msd all msd com yes
fix msdout all ave/time 100 1 100 &
    v_t c_msd[4] file msd_crystall.dat

fix npt all npt temp 300 300 0.1 iso 1 1 1
run 10000

unfix npt
unfix msdout
uncompute msd

fix npt all npt temp 300 1700 0.1 iso 1 1 1
run 50000

unfix npt
reset_timestep 0

compute msd all msd com yes
fix msdout all ave/time 100 1 100 &
    v_t c_msd[4] file msd_liquid_1700.dat
fix npt all npt temp 1700 1700 0.1 iso 1 1 1
run 10000

fix npt all npt temp 1700 2000 0.1 iso 1 1 1
run 10000

unfix npt
reset_timestep 0

compute msd all msd com yes
fix msdout all ave/time 100 1 100 &
    v_t c_msd[4] file msd_liquid_2000.dat
fix npt all npt temp 2000 2000 0.1 iso 1 1 1
run 10000
