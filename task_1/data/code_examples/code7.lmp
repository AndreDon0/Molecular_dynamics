units real
atom_style atomic
boundary p p p
neighbor 6 bin
neigh_modify every 1 delay 0 check yes

dimension 3
region bx block 0 800 0 800 0 800
create_box 1 bx
# fix 2d all enforce3d
create_atoms 1 random 10000 29786 bx
mass 1 39.948
# create_atoms 2 random 1 982 bx
# mass 2 80

pair_style lj/cut 6.0
pair_coeff * * 0.23627 3.4056

velocity all create 300 35709 dist gaussian
timestep 1

dump img all image 100 img.*.jpg type type zoom 1.7
dump_modify img backcolor white boxcolor black
# dump_modify img adiam 2 5.0
dump_modify img adiam 1 1.0

thermo 100
thermo_style custom step temp pe etotal press vol density

fix nve1 all npt temp 300 300 100 iso 1 1 1000

run 15000

fix nve1 all npt temp 300 300 100 iso 1 1000 1000 # сжимаем от 1 до 1000 атмосфер

run 15000

fix nve1 all npt temp 300 300 100 iso 1000 1000 1000

run 15000